# Either provide a full connection string...
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskflow

# ...or an Atlas URI with placeholders plus credentials, as Atlas exports them:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskflow
# MONGODB_USERNAME=
# MONGODB_PASSWORD=

JWT_SECRET=replace-with-at-least-32-random-chars
PORT=3000
NODE_ENV=development
